{
  "$schema": "https://opencode.ai/config.json",
  "model": "opencode-go/deepseek-v4-flash",

  "agent": {
    "manager": {
      "description": "Orkestrator utama — breakdown task ke subagent, review integrasi akhir, keputusan arsitektur",
      "mode": "primary",
      "model": "opencode-go/deepseek-v4-pro",
      "temperature": 0.2,
      "prompt": "{file:./AGENTS.md}",
      "permission": {
        "edit": "ask",
        "bash": "ask",
        "task": {
          "*": "allow"
        }
      }
    },

    "backend": {
      "description": "Schema database Prisma, API routes, autentikasi, logika bisnis",
      "mode": "subagent",
      "model": "opencode-go/kimi-k2.7-code",
      "temperature": 0.15,
      "permission": {
        "edit": "allow",
        "bash": "allow",
        "webfetch": "allow"
      }
    },

    "frontend": {
      "description": "Komponen UI, styling, design tokens, layout halaman",
      "mode": "subagent",
      "model": "opencode-go/glm-5.2",
      "temperature": 0.3,
      "permission": {
        "edit": "allow",
        "bash": "allow"
      }
    },

    "security": {
      "description": "Auth flow, proteksi route, validasi input, credential handling",
      "mode": "subagent",
      "model": "opencode-go/qwen3.7-max",
      "temperature": 0.1,
      "permission": {
        "edit": "deny",
        "bash": {
          "*": "ask",
          "git diff*": "allow",
          "git log*": "allow",
          "grep *": "allow",
          "rg *": "allow"
        },
        "webfetch": "ask"
      }
    }
  },

  "permission": {
    "skill": {
      "*": "allow"
    }
  },

  "formatter": {
    "ruff": {}
  },

  "plugin": [
    "opencode-ponytail"
  ],

  "mcp": {
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com"
    },
    "next-devtools": {
      "type": "local",
      "command": ["npx", "-y", "next-devtools-mcp@latest"]
    }
  },

  "autoupdate": true
}